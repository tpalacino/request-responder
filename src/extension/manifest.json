{
    "manifest_version": 3,
    "name": "Request Responder",
    "version": "1.1.1",
    "description": "Define rules for responding to requests.",
    "icons": {
        "1024": "logo.png"
    },
    "permissions": [
        "storage",
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "action": {
        "default_title": "Request Responder",
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "options_page": "index.html"
}